# ==============================================
# LARIZINHA STORE - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ==============================================
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env real ou o coloque em repositórios públicos.

# ---------- TELEGRAM ----------
# Token do bot obtido com @BotFather
TELEGRAM_TOKEN=

# IDs dos administradores (separados por vírgula, sem espaços)
# Exemplo: 123456789,987654321
ADMIN_IDS=

# Username do bot sem @ (para links de afiliado)
BOT_USERNAME=larizinhastorebot

# ---------- BANCO DE DADOS (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=larizinhastore
DB_USER=postgres
DB_PASSWORD=

# URL SQLAlchemy (opcional se usar as variáveis acima)
# DATABASE_URL=postgresql+asyncpg://postgres:SUA_SENHA_DB@localhost:5432/larizinhastore

# ---------- REDIS (para FSM e Celery) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MERCADO PAGO ----------
# Access Token do Mercado Pago (produção ou sandbox)
MP_ACCESS_TOKEN=

# Chave pública (opcional, para front-end)
MP_PUBLIC_KEY=

# Modo sandbox (true/false)
MP_SANDBOX=true

# ---------- WEBHOOK ----------
# URL pública do seu servidor para receber notificações do Mercado Pago
# Exemplo: https://seudominio.com/api/webhook/mercadopago
WEBHOOK_URL=

# Porta do servidor web (para receber webhooks)
WEBHOOK_PORT=8080

# ---------- CONFIGURAÇÕES DE PAGAMENTO ----------
# Tempo de expiração do PIX em minutos
PIX_EXPIRATION_MINUTES=10

# Valor mínimo de recarga
MIN_RECHARGE_VALUE=4.00

# Bônus de recarga (percentual)
RECHARGE_BONUS_PERCENT=10

# Valor mínimo para ganhar bônus
MIN_BONUS_VALUE=10.00

# ---------- AFILIADOS ----------
# Comissão padrão para afiliados (percentual)
DEFAULT_AFFILIATE_COMMISSION=10

# Saque mínimo para afiliados
MIN_WITHDRAWAL_VALUE=20.00

# ---------- ANTI-FLOOD ----------
# Número máximo de mensagens por minuto por usuário
FLOOD_MAX_MESSAGES_PER_MINUTE=5

# Tempo de bloqueio em segundos após exceder o limite
FLOOD_BLOCK_SECONDS=60

# ---------- LOGGING ----------
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=bot.log

# ---------- EMAIL (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ---------- WHATSAPP BUSINESS API ----------
# Token de acesso (se for usar WhatsApp para envio)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- MANUTENÇÃO ----------
# Se true, o bot fica em modo manutenção (apenas admins acessam)
MAINTENANCE_MODE=false

# ---------- OUTRAS ----------
# Timezone
TIMEZONE=America/Sao_Paulo
